# ===========================================================================
#  AI Edit Videos Bot  —  Environment configuration
#  Copy this file to ".env" and fill in the real values:
#      cp .env.example .env
# ===========================================================================

# --- Telegram ---
# Get this token from @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# The ONLY Telegram user ID allowed to use the bot (your own account).
# Find your ID by messaging @userinfobot
ADMIN_ID=123456789

# --- Optional: forward target ("Forward to Channel" button) ---
# Channel/chat ID (e.g. -1001234567890) or @channelusername. Leave empty to disable.
FORWARD_CHANNEL_ID=

# --- Research API (Tavily) — optional but recommended ---
# Free key at https://tavily.com . Leave empty to disable the research button.
TAVILY_API_KEY=

# --- Processing limits (tuned for Raspberry Pi 5 8GB) ---
# How many videos may be processed at the SAME time. Keep at 1 (or 2 max) on a Pi.
MAX_CONCURRENT_JOBS=1

# Maximum size for LINK downloads (yt-dlp), in megabytes.
# NOTE: videos you upload/forward in Telegram are capped much lower by the Bot
# API itself — 20 MB down, 50 MB up — and no setting here can raise that.
# Send a link instead of a file to bypass the 20 MB inbound limit.
MAX_VIDEO_MB=300

# Set true ONLY if you run your own Telegram Bot API server, which lifts both
# limits to 2000 MB. Leave false for the public api.telegram.org.
TELEGRAM_LOCAL_API=false

# Ask before editing. When true (default) the bot answers every incoming video
# with a menu — ♻️ repost / 🔴 strong / 🟡 medium / 🟢 light / ❌ cancel — and
# runs FFmpeg only after you pick one. Set to false to go straight to
# DEFAULT_INTENSITY without asking.
CONFIRM_BEFORE_EDIT=true

# Edit intensity applied when CONFIRM_BEFORE_EDIT=false, and the option set
# pre-selected on the confirmation menu.
#   repost -> reframe + temporal trim + audio pitch shift (the only preset that
#             meaningfully moves a perceptual fingerprint). RECOMMENDED.
#   strong -> same operations, smaller magnitudes
#   medium -> subtle reframe only, no temporal or audio edit
#   light  -> cosmetic only: changes the file hash, not the fingerprint
DEFAULT_INTENSITY=repost

# --- Hardware acceleration (decode side only) ---
# auto  -> probe what `ffmpeg -hwaccels` offers and test-decode it once at
#          startup; falls back to software silently if nothing works
# off   -> always use pure software (most compatible)
# <name>-> force a specific method, e.g. vaapi / drm / cuda. It is validated
#          against `ffmpeg -hwaccels`; an invalid name warns and uses software.
#
# On a Raspberry Pi 5 leave this alone: the Pi 5 has NO H.264 hardware decoder
# (only HEVC), so software decode is the correct and only path.
HW_ACCEL=auto

# --- Duplicate-input skipping ---
# Skip re-processing a source the bot already edited before (matches identical
# source bytes). true | false
SKIP_DUPLICATES=true
# Where the persistent hash registry lives (survives restarts). Clear it any
# time from Telegram with /forget.
DEDUP_DB=./dedup.json

# --- Storage ---
# Where temporary downloads / renders live (auto-cleaned).
WORK_DIR=/tmp/ai-edit-videos
# Where "Save to Folder" keeps the videos you want to keep.
SAVE_DIR=./saved
